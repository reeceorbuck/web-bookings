{
  "tasks": {
    "dev": "deno run -A --env-file=.env --watch=main.tsx,onlineBookings.ts,components serve.ts --lazy",
    "build": "deno run -A build.ts",
    "serve": "deno run -A serve.ts",
    "check": "deno check serve.ts build.ts",
    "lock": "deno run -A lock.ts"
  },
  "imports": {
    "tinytools": "jsr:@tinytools/hono-tools@0.1.50",
    "hono": "jsr:@hono/hono@^4.13.17"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "tinytools",
    "jsxPrecompileSkipElements": [
      "input",
      "option"
    ],
    "lib": [
      "esnext",
      "deno.ns",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "jsx-key"
      ]
    }
  }
}
